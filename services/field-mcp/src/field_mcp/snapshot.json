 "compliance_crosswalk_pack": {
  "body": {
   "additionalProperties": false,
   "description": "``POST /pack`` body \u2014 a thin adapter over ``crosswalk pack``.\n\n``manifest`` is REQUIRED. The shared resolver landed in v1.2 B0\n(``field_core.clients.resolve_manifest``) and the registry record carries\nthe ``manifest_ref`` it needs, but this service does not yet make that\nregistry-lookup-then-resolve call \u2014 so an ``agent_id`` alone still\nresolves to nothing here. Optionality by ``agent_id`` is NOT built. It\nis a plan-assigned D4 deliverable (A3: \"optionality lands in D4 after\nthe resolver exists\"; plan Decisions \u00a72) that D4 shipped without \u2014 open,\nand put to the plan owner to build or to move.",
   "properties": {
    "agent_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "description": "Collect live evidence for this agent",
     "title": "Agent Id"
    },
    "manifest": {
     "additionalProperties": true,
     "description": "FIELD manifest data",
     "title": "Manifest",
     "type": "object"
    },
    "signer": {
     "description": "Named human signer \u2014 no pack without one",
     "title": "Signer",
     "type": "string"
    },
    "sources": {
     "anyOf": [
      {
       "additionalProperties": false,
       "description": "Optional live artifacts, gathered by the caller/CLI. None = not collected.",
       "properties": {
        "governor_cap": {
         "anyOf": [
          {
           "additionalProperties": true,
           "type": "object"
          },
          {
           "type": "null"
          }
         ],
         "title": "Governor Cap"
        },
        "ledger_event_types": {
         "anyOf": [
          {
           "additionalProperties": {
            "type": "integer"
           },
           "type": "object"
          },
          {
           "type": "null"
          }
         ],
         "title": "Ledger Event Types"
        },
        "ledger_verify": {
         "anyOf": [
          {
           "additionalProperties": true,
           "type": "object"
          },
          {
           "type": "null"
          }
         ],
         "title": "Ledger Verify"
        },
        "registry_record": {
         "anyOf": [
          {
           "additionalProperties": true,
           "type": "object"
          },
          {
           "type": "null"
          }
         ],
         "title": "Registry Record"
        },
        "tokens": {
         "anyOf": [
          {
           "items": {
            "additionalProperties": true,
            "type": "object"
           },
           "type": "array"
          },
          {
           "type": "null"
          }
         ],
         "title": "Tokens"
        }
       },
       "title": "EvidenceSources",
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "signer",
    "manifest"
   ],
   "title": "PackRequest",
   "type": "object"
  },
