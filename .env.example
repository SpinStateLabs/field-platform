# FIELD Platform — environment template. Copy to .env; never commit .env.
# No real credentials anywhere in this repo. All values below are local-dev defaults.

# --- Service ports (integration demo / docker-compose) ---
FIELD_REGISTRY_PORT=8001
FIELD_LEDGER_PORT=8002
FIELD_DELEGATION_PORT=8003
FIELD_SENTINEL_PORT=8004
FIELD_KILLSWITCH_PORT=8005
FIELD_GOVERNOR_PORT=8006
FIELD_REPLAY_PORT=8007
FIELD_CROSSWALK_PORT=8008
FIELD_GATEWAY_PORT=8009
FIELD_FEDERATION_PORT=8010
FIELD_CONSOLE_PORT=8011

# federation-broker: our org name as counterparty manifests must declare it
FIELD_ORG_NAME=Spin State Labs

# --- Inter-service authn (OQ-1) ---
# Unset = localhost-trust demo mode. Set the SAME value in every service's
# and client's environment to require x-field-auth on all endpoints except
# /health. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FIELD_SHARED_SECRET=

# --- Data directories (default: ./var inside each service) ---
FIELD_DATA_DIR=./var

# --- force-gateway (Phase 3) — key is YOUR key, set only in your local .env ---
# ANTHROPIC_API_KEY=

# --- Conformance sentinel operating mode (S1 / ADR 02 safety ordering) ---
# Unset or "log_only" = safe-by-default: verdicts are shadow-ledgered as
# would-block/would-escalate but never enforced (the estate observes first).
# "enforce" = verdicts block/escalate for real. Graduate to enforce only after
# the measured gate (catch >= 95%, false-block <= 2%).
# NOTE: any unrecognized value silently falls back to log_only (fail-safe
# direction, but silent) — verify GET /health reports the mode you intended.
# FIELD_SENTINEL_MODE=log_only

# --- Sentinel semantic judge (S3 / ADR 02) — default OFF ---
# off (or unset) = structural-only, S2-identical behavior. "mock" = the
# deterministic keyless mock (tests/demos). "anthropic" = the real pinned
# model (needs ANTHROPIC_API_KEY; spend-metered to the sentinel's own
# governor cap — no cap, no judgments). Unrecognized values fall back to off.
# FIELD_SENTINEL_JUDGE=off
# FIELD_JUDGE_MODEL=claude-sonnet-5
# FIELD_JUDGE_CONFIDENCE_FLOOR=0.8
