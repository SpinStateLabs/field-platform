@@ -642,3 +642,81 @@ def test_a_failed_outcome_row_does_not_change_the_result_of_a_write_that_happene
         return real(*a, **k)
     d.writers["sealed-ledger"].request = flaky
     assert call(d, "agent_registry_create_agent")["status"] == "ok"
+
+
+# ---- C-1014 F-C941-2: the rate limit's controls each have a failing test (mutants T11, T12, T13, T15, C2) ----------------
+
+def test_the_ruled_default_rate_is_ten_per_minute_and_a_flag_only_config_gets_it():
+    """Don's ruling 2026-10-30 (write rate 10). Mutant C2: the default changed to 20."""
+    from field_mcp import config
+    assert config.DEFAULT_WRITE_RATE == 10
+    cfg = load(2, {"FFMCP_ENABLE_WRITES": "1", "FFMCP_SEALED_LEDGER_URL": "http://127.0.0.1:1"})
+    assert cfg.write_rate_per_min == 10
+
+
+def _timed(stub, rate=2):
+    d = wdisp(stub, rate=rate)
+    t = {"now": 1000.0}
+    d.clock = lambda: t["now"]
+    return d, t
+
+
+def test_the_window_is_sixty_seconds_and_its_edge_is_exact(stub):
+    """Mutants T13 (window 6 s) and T11 (>= to >): refused at 59.99 s, allowed at exactly 60.0 s, refused at 30 s."""
+    d, t = _timed(stub)
+    assert call(d, "compliance_crosswalk_regwatch_check")["status"] == "ok"
+    assert call(d, "compliance_crosswalk_regwatch_check")["status"] == "ok"
+    for later, allowed in ((30.0, False), (59.99, False), (60.0, True)):
+        t["now"] = 1000.0 + later
+        r = call(d, "compliance_crosswalk_regwatch_check")
+        assert (r["status"] == "ok") is allowed, later
+        if not allowed:
+            assert r == {"status": "error", "error": "write rate limit reached"}
+
+
+def test_the_limit_uses_the_monotonic_clock_and_a_clock_step_back_does_not_reopen_it(stub):
+    """Mutant T12: time.time for time.monotonic. A wall clock can be set back; the monotonic one cannot."""
+    d = wdisp(stub)
+    assert d.clock is time.monotonic
+    d, t = _timed(stub)
+    call(d, "compliance_crosswalk_regwatch_check")
+    call(d, "compliance_crosswalk_regwatch_check")
+    t["now"] -= 100.0                                       # the clock steps back
+    assert call(d, "compliance_crosswalk_regwatch_check")["error"] == "write rate limit reached"
+
+
+def test_the_limiter_takes_its_lock_and_holds_the_count_under_threads(stub):
+    """Mutant T15: the lock removed. One acquisition per admit is pinned directly; the thread run is a second check."""
+    import threading
+    d, _ = _timed(stub, rate=3)
+
+    class Spy:
+        def __init__(self, inner):
+            self.inner, self.n = inner, 0
+
+        def __enter__(self):
+            self.n += 1
+            return self.inner.__enter__()
+
+        def __exit__(self, *a):
+            return self.inner.__exit__(*a)
+
+    spy = Spy(d._lock)
+    d._lock = spy
+    d._admit()
+    assert spy.n == 1
+    d._lock = spy.inner
+    d, _ = _timed(stub, rate=3)
+    d.clock = lambda: (time.sleep(0), 1000.0)[1]            # yield inside the critical section
+    allowed = []
+
+    def go():
+        try:
+            d._admit()
+            allowed.append(1)
+        except cl.ToolError:
+            pass
+    ts = [threading.Thread(target=go) for _ in range(12)]
+    [x.start() for x in ts]
+    [x.join() for x in ts]
+    assert len(allowed) == 3
