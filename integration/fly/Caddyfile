# FIELD Platform — single-port reverse proxy for the Fly.io single-container
# estate. Same route map as integration/demo/Caddyfile (the compose ground
# truth — keep them in sync), but every upstream is loopback: all services
# run in THIS container on 127.0.0.1, and this :8080 listener is the only
# socket bound on 0.0.0.0 (Fly's http_service fronts it with TLS at the edge).
#
# One published origin; every service is a path prefix behind it. handle_path
# strips the matched prefix before proxying, so each app still sees root
# paths — /health stays inside the authn OPEN_PATHS set (field_core/authn.py)
# and no Python changes are needed anywhere.
#
# The ops-console owns the proxy ROOT: its static shell (console.html)
# fetches root-absolute /api/* paths and cannot live under a prefix without
# editing the HTML. Caddy handle blocks are mutually exclusive and matched
# most-specific-first, so the bare `handle` below is the console catch-all.
#
# x-field-auth is a plain request header; Caddy forwards it unchanged.
# TLS is NOT terminated here — Fly's edge terminates TLS (force_https in
# fly.toml) and forwards plaintext HTTP to internal_port 8080.
#
# compliance-crosswalk (:8008) stays uncomposed by design (CLI/offline
# tooling — STATE.md); add a handle_path /crosswalk/* block if that changes.
:8080 {
	handle_path /registry/* {
		reverse_proxy 127.0.0.1:8001
	}
	handle_path /ledger/* {
		reverse_proxy 127.0.0.1:8002
	}
	handle_path /delegation/* {
		reverse_proxy 127.0.0.1:8003
	}
	handle_path /sentinel/* {
		reverse_proxy 127.0.0.1:8004
	}
	handle_path /killswitch/* {
		reverse_proxy 127.0.0.1:8005
	}
	handle_path /governor/* {
		reverse_proxy 127.0.0.1:8006
	}
	handle_path /replay/* {
		reverse_proxy 127.0.0.1:8007
	}
	handle_path /gateway/* {
		reverse_proxy 127.0.0.1:8009
	}
	handle_path /federation/* {
		reverse_proxy 127.0.0.1:8010
	}
	handle {
		reverse_proxy 127.0.0.1:8011
	}
}
