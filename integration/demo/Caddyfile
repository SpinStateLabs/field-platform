# FIELD Platform — single-port reverse proxy for the compose stack.
#
# One published origin; every service is a path prefix behind it. handle_path
# strips the matched prefix before proxying, so each app still sees root
# paths — /health stays inside the authn OPEN_PATHS set (field_core/authn.py)
# and no Python changes are needed anywhere.
#
# The ops-console owns the proxy ROOT: its static shell (console.html)
# fetches root-absolute /api/* paths and cannot live under a prefix without
# editing the HTML. Caddy handle blocks are mutually exclusive and matched
# most-specific-first, so the bare `handle` below is the console catch-all.
#
# x-field-auth is a plain request header; Caddy forwards it unchanged.
# TLS is NOT terminated here — in a real deployment this proxy sits behind
# a TLS-terminating edge (Cloudflare Tunnel / Tailscale / Caddy with a
# domain), per every service's LIMITS line.
#
# Key rotation (slice R2, design S12): /operator/verify-hash and
# /operator/rotation-state are INTERNAL routes of the eight operator-block
# services. The proxy refuses them (403, never proxied) unless the request
# comes from this container's own loopback with no proxy hop in front of it:
# `rewrite` runs before every handle / handle_path, so no route prefix (or the
# console catch-all) can reach a backend with them. A request that arrived
# through another Caddy site (the GB10 TLS listener hands every request to
# 127.0.0.1:8080 and its reverse_proxy always sets X-Forwarded-For) is refused
# too. The rotator reaches the services on the compose network, never here.
# The GB10 file imports this route map, so 18080 and 18443 both refuse them.
:8080 {
	@kr_internal_remote {
		path */operator/verify-hash* */operator/rotation-state*
		not remote_ip 127.0.0.0/8 ::1
	}
	@kr_internal_forwarded {
		path */operator/verify-hash* */operator/rotation-state*
		header X-Forwarded-For *
	}
	rewrite @kr_internal_remote /__field_internal_route_refused
	rewrite @kr_internal_forwarded /__field_internal_route_refused
	handle /__field_internal_route_refused {
		respond "internal route: loopback only" 403
	}
	handle_path /registry/* {
		reverse_proxy registry:8001
	}
	handle_path /ledger/* {
		reverse_proxy ledger:8002
	}
	handle_path /delegation/* {
		reverse_proxy delegation:8003
	}
	handle_path /sentinel/* {
		reverse_proxy sentinel:8004
	}
	handle_path /killswitch/* {
		reverse_proxy killswitch:8005
	}
	handle_path /governor/* {
		reverse_proxy governor:8006
	}
	handle_path /replay/* {
		reverse_proxy replay:8007
	}
	handle_path /gateway/* {
		reverse_proxy forcegw:8009
	}
	handle_path /federation/* {
		reverse_proxy fedbroker:8010
	}
	handle_path /lifecycle/* {
		reverse_proxy lifecycle:8012
	}
	handle_path /attest/* {
		reverse_proxy attest:8013
	}
	handle_path /crosswalk/* {
		reverse_proxy crosswalk:8008
	}
	handle {
		# the console holds destructive controls (kill, drill, FLEET HALT) and the perimeter
		# secret in sessionStorage: no framing from another origin (reviewer C-91, clickjacking)
		header {
			X-Frame-Options DENY
			Content-Security-Policy "frame-ancestors 'none'"
			X-Content-Type-Options nosniff
		}
		reverse_proxy console:8011
	}
}
